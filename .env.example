# PostureFix Environment Variables
# Copy this file to .env and fill in your values

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Store / Google Play (for reference)
# Apple: Products configured as weekly/monthly/annual in App Store Connect
# Android: Products configured in Google Play Console
# RevenueCat entitlement name: "premium"
